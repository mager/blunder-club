  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A clear game action.",
      "html": "<button class=\"ds-primary\">Try again</button>",
      "css": ".ds-primary{font-family:\"DM Sans\",sans-serif;cursor:pointer;transition:background .15s ease,color .15s ease;background:var(--acid,#b8e3b0);color:#1d3223;border:0;border-radius:5px;min-height:44px;padding:12px 16px;font-size:13px;font-weight:600}.ds-primary:hover:not(:disabled){background:#d0f2c9;color:#15261a}.ds-primary:focus-visible{outline:2px solid var(--acid,#b8e3b0);outline-offset:4px}.ds-primary:disabled{opacity:.4;cursor:not-allowed}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A clear game action.",
      "html": "<button class=\"ds-secondary\">Undo</button>",
      "css": ".ds-secondary{font-family:\"DM Sans\",sans-serif;cursor:pointer;transition:background .15s ease,color .15s ease;background:transparent;color:var(--paper,#f0f0e9);border:1px solid var(--line,#354139);border-radius:5px;min-height:44px;padding:12px 16px;font-size:13px;font-weight:600}.ds-secondary:hover:not(:disabled){background:var(--raised,#2b332e);color:var(--acid,#b8e3b0)}.ds-secondary:focus-visible{outline:2px solid var(--acid,#b8e3b0);outline-offset:4px}.ds-secondary:disabled{opacity:.4;cursor:not-allowed}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
