  "narrative": {
    "northStar": "The late-night strategy game",
    "overview": "Nextmove uses a quiet, late-night strategy-game frame. Charcoal surfaces surround warm stone squares, ivory pieces, and jade move marks. The board carries the action; short, plain coaching appears when a decision needs support.\n\nThe interface uses code, SVG pieces, and line icons. It has no raster texture or decorative image layer. Type, color, and motion help the player read the next move.",
    "keyCharacteristics": [
      "A large, clear board within a quiet charcoal frame.",
      "Jade actions and warm warning states.",
      "DM Sans cues with condensed chess notation.",
      "Small control groups and explanations that open on request."
    ],
    "rules": [
      {
        "name": "The State Rule",
        "body": "Use color to reinforce a visible state, not as its only signal.",
        "section": "colors"
      },
      {
        "name": "The Plain Cue Rule",
        "body": "Keep coaching in sentence case and plain type. Reserve condensed type for chess notation.",
        "section": "typography"
      },
      {
        "name": "The One Screen Rule",
        "body": "Keep the board, guide, and main controls visible without page scrolling. Resize the board to fit the available space; do not clip page overflow to hide controls. Pause actions appear once in the guide, with no duplicate sticky action row.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do keep the board, pieces, destinations, and hint arrow clear at phone size.",
      "Do use jade for actions and current state, with labels or shapes for meaning.",
      "Do keep the coach concise and put longer move explanations and questions in dialogs.",
      "Do fit the board, guide, and main controls in one window without page scrolling.",
      "Do preserve keyboard focus, accessible labels, and reduced-motion support."
    ],
    "donts": [
      "Don't restore the old olive, acid-yellow, grain, or tilted-mark identity.",
      "Don't add a welcome hero, slogans, or a permanent lesson dashboard to play.",
      "Don't use condensed type for headings or teaching prose.",
