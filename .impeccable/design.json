      "html": "<button class=\"ds-text\">Play on \u2192</button>",
      "css": ".ds-text{font-family:\"DM Sans\",sans-serif;cursor:pointer;transition:background .15s ease,color .15s ease;background:none;border:0;color:var(--muted,#aab5ad);font-size:13px;min-height:40px;padding:8px 0}.ds-text:hover{color:var(--acid,#b8e3b0)}.ds-text:focus-visible{outline:2px solid var(--acid,#b8e3b0);outline-offset:4px}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    },
    {
      "name": "Question input",
      "kind": "input",
      "refersTo": "question-input",
      "description": "An optional question with a visible send control, shown in the Ask Rook dialog. Threat questions and answers use this dialog too.",
      "html": "<div class=\"ds-question\"><input aria-label=\"Ask about moves, threats, or castling\" placeholder=\"Ask Rook\u2026\"><button aria-label=\"Send question\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m22 2-7 20-4-9-9-4Z M22 2 11 13\"/></svg></button></div>",
      "css": ".ds-question{display:flex;gap:7px;border-bottom:1px solid #65786a}.ds-question input{font:16px \"DM Sans\",sans-serif;color:var(--paper,#f0f0e9);background:none;border:0;padding:12px 0;min-width:0;width:100%;caret-color:var(--acid,#b8e3b0)}.ds-question input::placeholder{color:var(--muted,#aab5ad)}.ds-question button{background:none;border:0;color:var(--paper,#f0f0e9);width:36px;cursor:pointer}.ds-question button:hover{color:var(--acid,#b8e3b0)}.ds-question input:focus-visible{outline:2px solid var(--acid,#b8e3b0);outline-offset:4px}.ds-question button:focus-visible{outline:2px solid var(--acid,#b8e3b0);outline-offset:4px}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    },
    {
      "name": "Coaching modes",
      "kind": "nav",
      "refersTo": "mode-switch",
      "description": "Two explicit coaching states.",
      "html": "<div class=\"ds-modes\" aria-label=\"Coaching mode\"><button aria-pressed=\"true\">Coach as I play</button><button aria-pressed=\"false\">Review after</button></div>",
      "css": ".ds-modes{display:flex;padding:4px;background:var(--ink,#151918);border-radius:7px}.ds-modes button{font-family:\"DM Sans\",sans-serif;cursor:pointer;transition:background .15s ease,color .15s ease;background:none;border:0;min-height:42px;flex:1;font-size:12px;color:var(--muted,#aab5ad);border-radius:4px}.ds-modes button[aria-pressed=true]{background:var(--raised,#2b332e);color:var(--acid,#b8e3b0)}.ds-modes button:hover{color:var(--acid,#b8e3b0)}.ds-modes button:focus-visible{outline:2px solid var(--acid,#b8e3b0);outline-offset:4px}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    },
    {
      "name": "Move choice",
      "kind": "chip",
      "refersTo": "move-choice",
      "description": "A selectable chess move that controls the board arrow. Phone choices use a 40px minimum height; Play and Why? share the action row below.",
      "html": "<button class=\"ds-move\" aria-pressed=\"true\">Nf3</button>",
      "css": ".ds-move{font-family:\"DM Sans\",sans-serif;cursor:pointer;transition:background .15s ease,color .15s ease;min-width:68px;min-height:48px;border:1px solid #688669;font-family:\"Barlow Condensed\",sans-serif;font-size:24px;border-radius:5px;background:var(--acid-dark,#324c38);color:var(--acid,#b8e3b0)}.ds-move:hover{background:var(--raised,#2b332e)}.ds-move:focus-visible{outline:2px solid var(--acid,#b8e3b0);outline-offset:4px}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}@media(max-width:760px){.ds-move{min-height:40px}}"
    },
    {
      "name": "Decision coach",
      "kind": "custom",
      "refersTo": "coach-dock",
      "description": "A compact cue and visible decisions beside the board, or below it on phones. Longer explanations open in a dialog. The guide has no duplicate sticky action row; game summaries show one main turning point and a Full review action.",
      "html": "<aside class=\"ds-coach\"><div class=\"ds-guide\">Rook \u00b7 Your guide</div><h1>Find your next move.</h1><p>Select a piece to see its legal moves.</p><div class=\"ds-coach-actions\"><button aria-haspopup=\"dialog\">Why this move?</button></div></aside>",
      "css": ".ds-coach{font-family:\"DM Sans\",sans-serif;color:var(--paper,#f0f0e9);width:260px}.ds-guide{font-size:13px;color:var(--muted,#aab5ad);margin-bottom:12px}.ds-coach h1{font-weight:500;font-size:28px;line-height:1.16;letter-spacing:-.7px;margin:0 0 12px}.ds-coach p{font-size:14px;line-height:1.65;color:var(--muted,#aab5ad);margin:0}.ds-coach-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:12px}.ds-coach-actions button{font:12px \"DM Sans\",sans-serif;background:none;border:0;color:var(--muted,#aab5ad);padding:8px 0;min-height:40px;cursor:pointer;transition:color .15s ease}.ds-coach-actions button:hover{color:var(--acid,#b8e3b0)}.ds-coach-actions button:focus-visible{outline:2px solid var(--acid,#b8e3b0);outline-offset:4px}@media(min-width:1550px){.ds-coach h1{font-size:32px}}@media(max-width:1050px){.ds-coach h1{font-size:26px}}@media(max-width:760px){.ds-coach{width:100%;max-width:480px;padding:0 4px}.ds-guide{margin-bottom:4px}.ds-coach h1{font-size:20px;line-height:1.15;margin-bottom:4px}.ds-coach p{font-size:13px;line-height:1.4}.ds-coach-actions{margin-top:6px;gap:8px}.ds-coach-actions button{min-height:44px}}@media(min-width:640px) and (max-height:540px){.ds-coach{width:240px;padding:0}.ds-guide{margin-bottom:4px}.ds-coach h1{font-size:20px;margin-bottom:4px}.ds-coach p{font-size:13px;line-height:1.4}.ds-coach-actions{margin-top:6px;gap:8px}}@media(prefers-reduced-motion:reduce){.ds-coach-actions button{transition:none!important}}"
    },
    {
      "name": "Dialog surface",
      "kind": "card",
      "refersTo": "dialog",
      "description": "A focused surface for secondary tasks, move explanations, coach questions, and full game review. Its header stays visible while content scrolls; full review lists all turning points and the available practice action.",
      "html": "<section class=\"ds-dialog\"><header><h2>Your game</h2><button aria-label=\"Close\">\u00d7</button></header><p>Practice and saved positions open here.</p></section>",
      "css": ".ds-dialog{font-family:\"DM Sans\",sans-serif;background:var(--surface,#1e2421);color:var(--paper,#f0f0e9);border:1px solid var(--line,#354139);border-radius:12px;box-shadow:0 24px 70px #0006;width:min(460px,100%)}.ds-dialog header{display:flex;align-items:center;justify-content:space-between;padding:20px 24px 12px}.ds-dialog h2{margin:0;font-size:22px;font-weight:500;letter-spacing:-.5px}.ds-dialog button{background:none;border:0;width:42px;height:42px;font-size:24px;color:var(--muted,#aab5ad);cursor:pointer;border-radius:5px}.ds-dialog button:hover{background:var(--raised,#2b332e);color:var(--acid,#b8e3b0)}.ds-dialog button:focus-visible{outline:2px solid var(--acid,#b8e3b0);outline-offset:4px}.ds-dialog p{margin:8px 24px 24px;font-size:14px;line-height:1.7}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    },
    {
      "name": "Board destinations",
      "kind": "custom",
      "refersTo": "chessboard",
      "description": "A small board-state sample. In play, the shell fills 100dvh under a 56px header (48px on phones). ResizeObserver fits the board to the width and height left by controls and the guide, capped at 720px. Phones stack the guide below; short landscape windows use two columns.",
      "html": "<div class=\"ds-board\" role=\"group\" aria-label=\"Board state sample\"><button aria-label=\"e4, empty, legal destination\"><span></span></button><button aria-label=\"f4, empty\"></button><button aria-label=\"e3, empty\"></button><button aria-label=\"f3, selected\" aria-pressed=\"true\"></button></div>",
      "css": ".ds-board{display:grid;grid-template-columns:repeat(2,1fr);width:160px;aspect-ratio:1;border-radius:3px;overflow:hidden;box-shadow:0 18px 45px #0003}.ds-board button{border:0;padding:0;background:var(--board-dark,#819284);display:grid;place-items:center;cursor:pointer}.ds-board button:first-child,.ds-board button:last-child{background:var(--board-light,#e7e5d7)}.ds-board button[aria-pressed=true]{background:#c7ef9dc4;box-shadow:inset 0 0 0 3px #364d30}.ds-board button:hover{background:#d4e8c966}.ds-board button:focus-visible{outline:3px solid #203728;outline-offset:-3px}.ds-board span{width:23%;height:23%;border-radius:50%;background:#20372850}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    }
