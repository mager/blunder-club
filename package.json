{
  "name": "blunder-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-engine.mjs && vite --host 127.0.0.1",
    "build": "node scripts/copy-engine.mjs && svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "openspec": "OPENSPEC_TELEMETRY=0 openspec",
    "spec:check": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict --no-interactive",
    "test:rules": "firebase emulators:exec --only firestore --project demo-nextmove \"vitest run tests/library-cloud.rules.test.ts\""
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@lucide/svelte": "^1.64.0",
    "chess.js": "1.4.0",
    "firebase": "12.4.0",
    "stockfish": "19.0.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@fission-ai/openspec": "1.16.0",
    "@playwright/test": "^1.56.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.4",
    "svelte-check": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
