# Server-only. Never use a VITE_ prefix for an API key.
TYPESAFE_API_KEY=

# Firebase web configuration is public client configuration, not a server secret.
# Enable only after Google provider and authorized domains are configured.
VITE_FIREBASE_AUTH_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
